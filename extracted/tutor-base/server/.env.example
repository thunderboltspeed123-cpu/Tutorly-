# Copy this file to .env (or set these in your hosting settings). Never share or commit the real key.
ANTHROPIC_API_KEY=paste-your-key-here
CLAUDE_MODEL=claude-sonnet-5-5
# Address of the app that calls this server, e.g. https://your-app.web.app. Use * only while testing.
ALLOWED_ORIGIN=*
PORT=3000
